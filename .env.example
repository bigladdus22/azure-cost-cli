# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Azure Retail Prices (public API, no auth needed) ---
AZURE_COST_CURRENCY=EUR
AZURE_COST_REGION=westeurope
# Comma-separated regions to add to the built-in allow-list, if you need one.
# AZURE_COST_EXTRA_REGIONS=uksouth,francecentral

# --- Supabase (inventory source + snapshot store) ---
SUPABASE_URL=https://YOUR-REF.supabase.co
# Use the service-role key so the CLI can read inventory and write snapshots.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
